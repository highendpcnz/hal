# Running another HAL instance on this machine (a different checkout, a
# launchd/autostart agent, etc.)? Give this one its own port so they don't
# fight over 8000.
# HAL_PORT=8001

# Local Gemma is the default and requires no API key.
HAL_BRAIN=gemma
HAL_MANAGE_GEMMA=1
HAL_GEMMA_URL=http://127.0.0.1:8080/v1/chat/completions
HAL_GEMMA_MODEL=gemma-4-e2b
HAL_LLAMA_SERVER=/Users/hal/llama.cpp/build/bin/llama-server
HAL_GEMMA_MODEL_PATH=/Users/hal/models/gemma-4-e2b/gemma-4-E2B-it-Q4_0.gguf
# HAL_GEMMA_MMPROJ=/Users/hal/models/gemma-4-e2b/mmproj-gemma-4-E2B-it-Q8_0.gguf
HAL_ROBOT_PORT=/dev/ttyACM0

# capture_visual_scene is only offered to Gemma once HAL_GEMMA_MMPROJ (above) is
# set. On the Mac it shells out to ffmpeg against the dev webcam; override
# HAL_CAMERA_DEVICE for a non-default one. On Termux/Pixel it auto-detects and
# uses the phone's own camera instead (see robot/camera.py) — no override needed.
# HAL_CAMERA_DEVICE=0
# HAL_CAMERA_WIDTH=640
# HAL_CAMERA_HEIGHT=480

# On-device (Pixel/Termux) hands-free voice loop — see termux_voice.py and
# docs/termux-port-status.md. Off by default: it listens continuously.
# HAL_TERMUX_LISTEN=1
#
# STT backend for that loop. "whispercpp" (default) records a bounded clip with
# termux-microphone-record and decodes it with whisper.cpp. "android" uses
# termux-speech-to-text, which hangs forever and returns nothing on the Pixel
# under test (Android SDK 37) — kept only for devices where it works.
# HAL_TERMUX_STT_BACKEND=whispercpp
# HAL_TERMUX_CLIP_SECONDS=6
#
# Peak level below which a clip is discarded without decoding. Whisper invents
# fluent speech from room noise, and a hallucination can contain the wake word,
# so this gate is what stops an always-listening robot waking itself.
# HAL_TERMUX_SILENCE_DBFS=-45
#
# Wake word for the on-device loop. Empty disables the gate entirely (HAL then
# answers everything it hears). The default "hal" additionally recovers the
# homophones whisper produces for it — see termux_voice.py.
# HAL_WAKE_WORD=hal
#
# Require an attention word, i.e. "hey HAL" rather than a bare "HAL". On by
# default because a bare name cannot be made safe against a television: a film
# playing in the room produced "HAL, the real value of a conflict..." and HAL
# answered it. Setting this to 0 restores the bare name — and that behaviour.
# HAL_WAKE_REQUIRE_ATTENTION=1
#
# STT bias prompt. Strongly recommended on the Pixel: without it base.en hears
# the spoken name "HAL" as "How"/"huh" and the wake word never fires. This exact
# prompt was chosen against a real recording. Do not shorten it to bare repeated
# names ("HAL. HAL. HAL 9000.") — that collapsed a whole utterance to one word
# in testing. A bias prompt also increases hallucination on quiet input, so keep
# the silence gate above enabled alongside it.
# HAL_STT_PROMPT=HAL. HAL 9000. Dave is speaking to HAL. HAL, are you there?
#
# whisper.cpp assets, auto-detected by presence at these defaults:
# HAL_WHISPER_CPP_BIN=~/whisper.cpp/build/bin/whisper-cli
# HAL_WHISPER_CPP_MODEL=~/whisper.cpp/models/ggml-base.en.bin

# Optional legacy compatibility provider:
# HAL_BRAIN=hermes
# HAL_BRIDGE=acp

# This file documents the Mac dev setup. The Pixel/Termux deployment needs a
# genuinely different .env (different absolute paths, no HAL_ROBOT_PORT, a
# HAL_VENV override) — see docs/termux-port-status.md, "Gemma running locally
# on the Pixel", rather than adapting this one.
