# Running another HAL instance on this machine (a different checkout, a
# launchd/autostart agent, etc.)? Give this one its own port so they don't
# fight over 8000.
# HAL_PORT=8001

# Local Gemma is the default and requires no API key.
HAL_BRAIN=gemma
HAL_MANAGE_GEMMA=1
HAL_GEMMA_URL=http://127.0.0.1:8080/v1/chat/completions
HAL_GEMMA_MODEL=gemma-4-e2b
HAL_LLAMA_SERVER=/Users/hal/llama.cpp/build/bin/llama-server
HAL_GEMMA_MODEL_PATH=/Users/hal/models/gemma-4-e2b/gemma-4-E2B-it-Q4_0.gguf
# HAL_GEMMA_MMPROJ=/Users/hal/models/gemma-4-e2b/mmproj-gemma-4-E2B-it-Q8_0.gguf
HAL_ROBOT_PORT=/dev/ttyACM0

# capture_visual_scene is only offered to Gemma once HAL_GEMMA_MMPROJ (above) is
# set. On the Mac it shells out to ffmpeg against the dev webcam; override
# HAL_CAMERA_DEVICE for a non-default one. On Termux/Pixel it auto-detects and
# uses the phone's own camera instead (see robot/camera.py) — no override needed.
# HAL_CAMERA_DEVICE=0
# HAL_CAMERA_WIDTH=640
# HAL_CAMERA_HEIGHT=480

# Optional legacy compatibility provider:
# HAL_BRAIN=hermes
# HAL_BRIDGE=acp

# This file documents the Mac dev setup. The Pixel/Termux deployment needs a
# genuinely different .env (different absolute paths, no HAL_ROBOT_PORT, a
# HAL_VENV override) — see docs/termux-port-status.md, "Gemma running locally
# on the Pixel", rather than adapting this one.
